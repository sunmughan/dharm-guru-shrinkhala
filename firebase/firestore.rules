rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    // A user reads and writes only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Phase 8: one users own birth profiles, saved reports
      // and saved calculation results. Only that user, or the
      // owner, reads them.
      match /birth_profiles/{doc} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == uid || isOwner());
      }
      match /reports/{doc} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == uid || isOwner());
      }
      match /saved_results/{doc} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == uid || isOwner());
      }
    }

    // Admin access is recorded in /admins/{uid} with role 'owner'.
    // The owner creates that record himself in the console; see
    // FIREBASE-SETUP.md. Only the owner reads it.
    match /admins/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Published content. Signed in users read it. Only the owner
    // writes it, from the admin app.
    match /horoscopes/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    match /astrologers/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    match /panchang/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Plans, payments, notifications and moderation. Signed in
    // users read plans and the notifications sent to them. Only
    // the owner writes any of these.
    match /plans/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    match /payments/{doc} {
      allow read: if isOwner() ||
        (request.auth != null &&
          resource.data.userId == request.auth.uid);
      allow write: if isOwner();
    }
    match /notifications/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    // Phase 8 bookings: a signed in user creates a booking
    // only for themselves, reads only their own bookings, and
    // cancels only their own. The owner reads and confirms
    // every booking.
    match /bookings/{doc} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isOwner());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isOwner());
      allow delete: if isOwner();
    }
    // Phase 8 reviews: signed in users read them and write
    // only their own. Nobody edits a review after saving it.
    match /reviews/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }
    match /moderation/{doc} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    // Consult chats. A signed in user reads and writes only
    // the chats they take part in, and sends only as
    // themselves. The owner reads and replies in every chat.
    // No astrologer identity exists yet, so the admin answers
    // until one is added.
    match /chats/{chatId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.participantIds || isOwner());
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.participantIds || isOwner());
      match /messages/{msgId} {
        allow read: if request.auth != null &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isOwner());
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
