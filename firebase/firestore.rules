rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    // A user reads and writes only their own profile document.
    // The owner also reads and writes user documents, for
    // status, verification, and suspension in user management.
    match /users/{uid} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || isOwner());

      // Phase 8: one users own birth profiles, saved reports
      // and saved calculation results. Only that user, or the
      // owner, reads them.
      match /birth_profiles/{doc} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == uid || isOwner());
      }
      match /reports/{doc} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == uid || isOwner());
      }
      match /saved_results/{doc} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == uid || isOwner());
      }
    }

    // Admin access is recorded in /admins/{uid} with role 'owner'.
    // The owner creates that record himself in the console; see
    // FIREBASE-SETUP.md. A signed in user creates only their own
    // record, which is how a Google sign in first opens admin
    // access. Only the owner changes or revokes a role.
    match /admins/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isOwner());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isOwner();
    }

    // Admin invitations. Owner only.
    match /admin_invites/{doc} {
      allow read, write: if isOwner();
    }

    // Astrology library entries. Signed in users read them.
    // Only the owner writes them, from the admin app.
    match /library_items/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Calculation configuration versions. Owner only. The user
    // app never reads a draft, only the active version, and
    // only once the owner publishes it through the app.
    match /calc_configs/{doc} {
      allow read, write: if isOwner();
    }

    // Managed content items. Signed in users read published
    // items. Only the owner writes them, from the admin app.
    match /content_items/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Consultations. The owner reads and writes every booking.
    // A user reads only their own booking and creates a booking
    // only for themselves.
    match /consultations/{doc} {
      allow read: if isOwner() || (request.auth != null &&
        request.auth.uid == resource.data.userId);
      allow create: if isOwner() || (request.auth != null &&
        request.auth.uid == request.resource.data.userId);
      allow update, delete: if isOwner();
    }

    // Audit logs. Owner only, read and write.
    match /audit_logs/{doc} {
      allow read, write: if isOwner();
    }

    // Activity events for active user metrics. Signed in users
    // write their own activity; only the owner reads it.
    match /activity_events/{doc} {
      allow read: if isOwner();
      allow create: if request.auth != null;
    }

    // Published content. Signed in users read it. Only the owner
    // writes it, from the admin app.
    match /horoscopes/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    match /astrologers/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    match /panchang/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Plans, payments, notifications and moderation. Signed in
    // users read plans and the notifications sent to them. Only
    // the owner writes any of these.
    match /plans/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    match /payments/{doc} {
      allow read: if isOwner() ||
        (request.auth != null &&
          resource.data.userId == request.auth.uid);
      allow write: if isOwner();
    }
    match /notifications/{doc} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    // Phase 8 bookings: a signed in user creates a booking
    // only for themselves, reads only their own bookings, and
    // cancels only their own. The owner reads and confirms
    // every booking.
    match /bookings/{doc} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isOwner());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isOwner());
      allow delete: if isOwner();
    }
    // Phase 8 reviews: signed in users read them and write
    // only their own. Nobody edits a review after saving it.
    match /reviews/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner();
    }
    match /moderation/{doc} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    // Consult chats. A signed in user reads and writes only
    // the chats they take part in, and sends only as
    // themselves. The owner reads and replies in every chat.
    // No astrologer identity exists yet, so the admin answers
    // until one is added.
    match /chats/{chatId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.participantIds || isOwner());
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.participantIds || isOwner());
      match /messages/{msgId} {
        allow read: if request.auth != null &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isOwner());
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
