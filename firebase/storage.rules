rules_version = '2';

// Storage rules for Dharm Guru Shrinkhala. The app has no
// Storage usage yet and no firebase_storage dependency, so
// these rules are the prepared default for when uploads land:
// deny everything by default, a signed in user reads and
// writes only under their own folder, the owner reads and
// writes published content. Deploy with the Firestore rules
// only after a Storage bucket exists in the console.
// Live status: NOT_TESTED, no Storage bucket exists yet.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileName} {
      allow read, write: if request.auth != null &&
        request.auth.uid == uid;
    }
    match /published/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
